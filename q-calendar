<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ระบบปฏิทินการจองห้องประชุม</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Sarabun', sans-serif; background-color: #f8fafc; }
    .tab-active { background-color: #0284c7 !important; color: white !important; }
  </style>
</head>
<body class="text-slate-700">

  <!-- Header ด้านบน -->
  <div class="bg-[#005aab] text-white px-6 py-3 flex justify-between items-center shadow-md">
    <div class="flex items-center space-x-2">
      <i class="fa-regular fa-calendar-check text-lg"></i>
      <span class="font-bold text-base md:text-lg">ปฏิทินจองห้องประชุม</span>
    </div>
    <div class="flex items-center space-x-3">
      <button onclick="fetchBookings()" title="รีเฟรชข้อมูล" class="text-xs bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded transition flex items-center space-x-1">
        <i class="fa-solid fa-rotate-right" id="refreshIcon"></i>
        <span class="hidden sm:inline">อัปเดตข้อมูล</span>
      </button>
      <div class="text-xs text-blue-100 font-light hidden md:block">ระบบแสดงผลรายการจอง</div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto p-4 md:p-6 space-y-4">
    
    <!-- ปุ่มสลับมุมมอง 3 แบบ -->
    <div class="flex items-center space-x-2">
      <button id="btn-list" onclick="switchView('list')" class="tab-active flex items-center px-4 py-2 rounded-lg bg-white border border-slate-200 shadow-sm text-sm font-medium transition">
        <i class="fa-solid fa-list-ul mr-2"></i> รายการ
      </button>
      <button id="btn-cal" onclick="switchView('cal')" class="flex items-center px-4 py-2 rounded-lg bg-white border border-slate-200 shadow-sm text-slate-600 text-sm font-medium hover:bg-slate-50 transition">
        <i class="fa-regular fa-calendar-days mr-2"></i> ปฏิทิน
      </button>
      <button id="btn-timeline" onclick="switchView('timeline')" class="flex items-center px-4 py-2 rounded-lg bg-white border border-slate-200 shadow-sm text-slate-600 text-sm font-medium hover:bg-slate-50 transition">
        <i class="fa-solid fa-chart-gantt mr-2"></i> ไทม์ไลน์
      </button>
    </div>

    <!-- แถบค้นหาและตัวกรองข้อมูล -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-3">
      <div class="relative">
        <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-slate-400"></i>
        <input type="text" id="searchInput" oninput="filterData()" placeholder="ค้นหาเรื่องประชุม หน่วยงาน หรือห้อง" 
          class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-sky-500 bg-slate-50">
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
        <select id="filterRoom" onchange="filterData()" class="p-2 border border-slate-200 rounded-lg bg-white text-slate-600">
          <option value="">ทุกห้องประชุม (3)</option>
          <option value="ห้องประชุม 1">ห้องประชุม 1</option>
          <option value="ห้องประชุม 2">ห้องประชุม 2</option>
          <option value="ห้องประชุม 3">ห้องประชุม 3</option>
        </select>
        <select id="filterTime" onchange="filterData()" class="p-2 border border-slate-200 rounded-lg bg-white text-slate-600">
          <option value="">ทุกช่วงเวลา</option>
          <option value="morning">ช่วงเช้า (ก่อน 12:00)</option>
          <option value="afternoon">ช่วงบ่าย (หลัง 12:00)</option>
        </select>
        <select id="filterDept" onchange="filterData()" class="p-2 border border-slate-200 rounded-lg bg-white text-slate-600">
          <option value="">ทุกหน่วยงาน/ผู้จอง</option>
        </select>
        <select id="filterType" onchange="filterData()" class="p-2 border border-slate-200 rounded-lg bg-white text-slate-600">
          <option value="">ทุกประเภท</option>
          <option value="ประชุม">ประชุม</option>
        </select>
      </div>
    </div>

    <!-- โหลดดิ้งสปินเนอร์ -->
    <div id="loading" class="text-center py-12 bg-white rounded-xl border border-slate-200 shadow-sm">
      <i class="fa-solid fa-circle-notch fa-spin text-3xl text-sky-600 mb-2"></i>
      <p class="text-sm text-slate-500">กำลังเชื่อมต่อข้อมูลจาก Google Calendar...</p>
    </div>

    <!-- 1. มุมมองแบบรายการ -->
    <div id="view-list" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-[#0070c0] text-white">
            <tr>
              <th onclick="toggleDateSort()" class="py-3 px-4 font-medium text-center w-40 cursor-pointer select-none hover:bg-[#005aab] transition group" title="คลิกเพื่อสลับการเรียงลำดับวันที่">
                <div class="inline-flex items-center justify-center space-x-1.5">
                  <span>วันที่จอง</span>
                  <span id="dateSortIcon" class="text-xs text-blue-200 group-hover:text-white">
                    <i class="fa-solid fa-sort-up"></i>
                  </span>
                </div>
              </th>
              <th class="py-3 px-4 font-medium text-center w-36">เวลาประชุม</th>
              <th class="py-3 px-4 font-medium w-44">ห้องที่จอง</th>
              <th class="py-3 px-4 font-medium">เรื่องที่ประชุม</th>
              <th class="py-3 px-4 font-medium w-52">หน่วยงาน/ผู้จอง</th>
              <th class="py-3 px-4 font-medium text-center w-28">ประเภท</th>
            </tr>
          </thead>
          <tbody id="listTableBody" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
    </div>

    <!-- 2. มุมมองแบบปฏิทิน -->
    <div id="view-cal" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-5">
      <div class="flex justify-between items-center mb-4">
        <h2 id="calendarMonthTitle" class="text-lg font-bold text-slate-800"></h2>
        <div class="flex space-x-1">
          <button onclick="prevMonth()" class="px-3 py-1 border rounded hover:bg-slate-100 text-sm"><i class="fa-solid fa-chevron-left"></i></button>
          <button onclick="currentMonthView()" class="px-3 py-1 border rounded hover:bg-slate-100 text-sm">วันนี้</button>
          <button onclick="nextMonth()" class="px-3 py-1 border rounded hover:bg-slate-100 text-sm"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
      </div>
      <div class="grid grid-cols-7 gap-px bg-slate-200 border border-slate-200 rounded-lg overflow-hidden text-center text-xs font-semibold text-slate-600">
        <div class="bg-slate-50 py-2">อา</div><div class="bg-slate-50 py-2">จ</div><div class="bg-slate-50 py-2">อ</div>
        <div class="bg-slate-50 py-2">พ</div><div class="bg-slate-50 py-2">พฤ</div><div class="bg-slate-50 py-2">ศ</div><div class="bg-slate-50 py-2">ส</div>
      </div>
      <div id="calendarDaysGrid" class="grid grid-cols-7 gap-px bg-slate-200 border-x border-b border-slate-200 text-xs"></div>
    </div>

    <!-- 3. มุมมองแบบไทม์ไลน์ -->
    <div id="view-timeline" class="hidden bg-white rounded-xl shadow-sm border border-slate-200 p-5 space-y-4">
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-3">
          <input type="date" id="timelineDateInput" onchange="renderTimeline()" class="border border-slate-200 p-1.5 rounded-lg text-sm font-medium">
          <span id="timelineSelectedDateText" class="font-bold text-slate-800 text-base"></span>
        </div>
        <div class="flex items-center space-x-4 text-xs font-medium">
          <div class="flex items-center"><span class="w-3.5 h-3.5 rounded bg-sky-500 mr-1.5"></span> ประชุม</div>
        </div>
      </div>

      <!-- แถบเลือกวัน -->
      <div id="timelineDayPills" class="flex overflow-x-auto space-x-2 pb-2"></div>

      <!-- ผังตารางไทม์ไลน์ -->
      <div class="overflow-x-auto border border-slate-200 rounded-lg shadow-sm">
        <div class="min-w-[980px]">
          <div class="flex bg-slate-100 border-b border-slate-200 text-[12px] font-semibold text-slate-600 py-2.5">
            <div class="w-36 pl-3 flex-shrink-0">ห้องที่จอง</div>
            <div class="flex-1 grid grid-cols-11 text-left relative">
              <div class="border-l border-slate-300 pl-1">07:00</div>
              <div class="border-l border-slate-300 pl-1">08:00</div>
              <div class="border-l border-slate-300 pl-1">09:00</div>
              <div class="border-l border-slate-300 pl-1">10:00</div>
              <div class="border-l border-slate-300 pl-1">11:00</div>
              <div class="border-l border-slate-300 pl-1">12:00</div>
              <div class="border-l border-slate-300 pl-1">13:00</div>
              <div class="border-l border-slate-300 pl-1">14:00</div>
              <div class="border-l border-slate-300 pl-1">15:00</div>
              <div class="border-l border-slate-300 pl-1">16:00</div>
              <div class="border-l border-slate-300 pl-1">17:00</div>
              <div class="absolute right-0 top-0 bottom-0 pr-1 text-slate-400 font-normal">18:00</div>
            </div>
          </div>
          <div id="timelineRows" class="divide-y divide-slate-100 bg-white"></div>
        </div>
      </div>
    </div>

  </div>

  <script>
    // =========================================================================
    // ตั้งค่า URL ของ Google Apps Script Web App ที่ Deploy แล้วตรงนี้
    // =========================================================================
    const GAS_WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbykNkyufItsWW4tfu71Kbf2B2GzJFoiu1XfKIJMD2XbLufAKDEdNZG09_F9SbQU_lrL/exec';

    let rawBookings = [];
    let dateSortOrder = 'asc';
    let currentViewDate = new Date();
    let currentActiveTab = 'list';
    const thaiMonths = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];
    const roomsList = ['ห้องประชุม 1', 'ห้องประชุม 2', 'ห้องประชุม 3'];

    window.onload = function() {
      const todayStr = formatDateKey(new Date());
      document.getElementById('timelineDateInput').value = todayStr;
      fetchBookings();
    };

    async function fetchBookings() {
      const loadingEl = document.getElementById('loading');
      const refreshIcon = document.getElementById('refreshIcon');
      
      if (rawBookings.length === 0) {
        loadingEl.classList.remove('hidden');
      }
      refreshIcon.classList.add('fa-spin');

      try {
        if (GAS_WEB_APP_URL.includes('YOUR_SCRIPT_ID')) {
          throw new Error('กรุณาระบุ URL ของ Google Apps Script Web App ในตัวแปร GAS_WEB_APP_URL ก่อนใช้งาน');
        }

        const response = await fetch(GAS_WEB_APP_URL);
        if (!response.ok) {
          throw new Error(`HTTP Error: ${response.status}`);
        }
        
        const data = await response.json();
        onDataLoaded(data);
      } catch (err) {
        onError(err);
      } finally {
        refreshIcon.classList.remove('fa-spin');
      }
    }

    function onDataLoaded(data) {
      rawBookings = Array.isArray(data) ? data : [];
      document.getElementById('loading').classList.add('hidden');
      buildDeptFilter();
      switchView(currentActiveTab);
    }

    function onError(err) {
      const loadingEl = document.getElementById('loading');
      loadingEl.classList.remove('hidden');
      loadingEl.innerHTML = `
        <div class="text-rose-600 p-4 max-w-lg mx-auto">
          <i class="fa-solid fa-triangle-exclamation text-3xl mb-2"></i>
          <p class="font-bold text-base mb-1">ไม่สามารถเชื่อมต่อข้อมูลได้</p>
          <p class="text-sm text-slate-600 mb-3">${err.message || err}</p>
          <button onclick="location.reload()" class="px-4 py-1.5 bg-rose-100 text-rose-700 rounded-lg text-xs font-semibold hover:bg-rose-200 transition">
            ลองใหม่อีกครั้ง
          </button>
        </div>`;
    }

    function switchView(view) {
      currentActiveTab = view;
      ['list', 'cal', 'timeline'].forEach(v => {
        document.getElementById(`view-${v}`).classList.add('hidden');
        document.getElementById(`btn-${v}`).classList.remove('tab-active', 'text-white');
        document.getElementById(`btn-${v}`).classList.add('text-slate-600');
      });

      document.getElementById(`view-${view}`).classList.remove('hidden');
      document.getElementById(`btn-${view}`).classList.add('tab-active', 'text-white');
      document.getElementById(`btn-${view}`).classList.remove('text-slate-600');

      if (view === 'list') renderList();
      if (view === 'cal') renderCalendar();
      if (view === 'timeline') renderTimeline();
    }

    function toggleDateSort() {
      dateSortOrder = (dateSortOrder === 'asc') ? 'desc' : 'asc';
      const icon = document.getElementById('dateSortIcon');
      icon.innerHTML = dateSortOrder === 'asc' 
        ? '<i class="fa-solid fa-sort-up"></i>' 
        : '<i class="fa-solid fa-sort-down"></i>';
      renderList();
    }

    function filterData() {
      if (currentActiveTab === 'list') renderList();
      if (currentActiveTab === 'cal') renderCalendar();
      if (currentActiveTab === 'timeline') renderTimeline();
    }

    function getFilteredEvents() {
      const text = document.getElementById('searchInput').value.toLowerCase();
      const room = document.getElementById('filterRoom').value;
      const time = document.getElementById('filterTime').value;
      const dept = document.getElementById('filterDept').value;
      const type = document.getElementById('filterType').value;

      return rawBookings.filter(b => {
        const matchText = b.title.toLowerCase().includes(text) || b.room.toLowerCase().includes(text) || b.creator.toLowerCase().includes(text);
        const matchRoom = !room || b.room === room;
        const matchDept = !dept || b.creator === dept;
        const matchType = !type || b.type === type;
        let matchTime = true;
        if (time === 'morning') matchTime = b.startHour < 12;
        if (time === 'afternoon') matchTime = b.startHour >= 12;
        return matchText && matchRoom && matchDept && matchType && matchTime;
      });
    }

    // 1. เรนเดอร์มุมมองรายการ
    function renderList() {
      let data = getFilteredEvents();
      data.sort((a, b) => {
        return dateSortOrder === 'asc' ? a.rawStart - b.rawStart : b.rawStart - a.rawStart;
      });

      const tbody = document.getElementById('listTableBody');
      if (data.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="text-center py-8 text-slate-400">ไม่พบข้อมูลการจองห้องประชุม</td></tr>`;
        return;
      }

      tbody.innerHTML = data.map((item, idx) => `
        <tr class="${idx % 2 === 0 ? 'bg-white' : 'bg-[#fcfdfe]'} hover:bg-sky-50/50 transition text-[13px]">
          <td class="py-3 px-4 text-center font-medium text-slate-600 whitespace-nowrap">${item.displayDate}</td>
          <td class="py-3 px-4 text-center text-slate-700 whitespace-nowrap font-medium">${item.startTime} - ${item.endTime}</td>
          <td class="py-3 px-4 font-semibold text-slate-800">${item.room}</td>
          <td class="py-3 px-4 text-slate-800 font-medium">${item.title}</td>
          <td class="py-3 px-4 text-slate-600">${item.creator}</td>
          <td class="py-3 px-4 text-center">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-100 text-sky-800">${item.type}</span>
          </td>
        </tr>
      `).join('');
    }

    // 2. เรนเดอร์มุมมองปฏิทิน
    function renderCalendar() {
      const year = currentViewDate.getFullYear();
      const month = currentViewDate.getMonth();
      document.getElementById('calendarMonthTitle').innerText = `${thaiMonths[month]} ${year + 543}`;

      const firstDay = new Date(year, month, 1).getDay();
      const totalDays = new Date(year, month + 1, 0).getDate();
      const data = getFilteredEvents();

      const grid = document.getElementById('calendarDaysGrid');
      grid.innerHTML = '';

      for (let i = 0; i < firstDay; i++) {
        grid.innerHTML += `<div class="bg-slate-50 min-h-[95px] p-1.5 border-t border-slate-200 opacity-40"></div>`;
      }

      for (let d = 1; d <= totalDays; d++) {
        const dStr = `${year}-${(month + 1).toString().padStart(2, '0')}-${d.toString().padStart(2, '0')}`;
        const dayEvents = data.filter(e => e.dateKey === dStr);

        let eventBadges = dayEvents.slice(0, 3).map(e => `
          <div class="bg-sky-100 text-sky-950 border-l-2 border-sky-600 p-1 rounded text-[11px] font-medium truncate mb-1 shadow-sm" title="${e.startTime} ${e.room} - ${e.title}">
            <span class="font-bold text-sky-700">${e.startTime}</span> ${e.room}
          </div>
        `).join('');

        if (dayEvents.length > 3) {
          eventBadges += `<div class="text-[10px] text-sky-700 font-bold text-center">+${dayEvents.length - 3} รายการ</div>`;
        }

        grid.innerHTML += `
          <div class="bg-white min-h-[95px] p-1.5 border-t border-slate-200 flex flex-col justify-between hover:bg-slate-50">
            <div class="font-bold text-slate-700 mb-1">${d}</div>
            <div class="flex-1">${eventBadges}</div>
          </div>`;
      }
    }

    function prevMonth() { currentViewDate.setMonth(currentViewDate.getMonth() - 1); renderCalendar(); }
    function nextMonth() { currentViewDate.setMonth(currentViewDate.getMonth() + 1); renderCalendar(); }
    function currentMonthView() { currentViewDate = new Date(); renderCalendar(); }

    // 3. เรนเดอร์มุมมองไทม์ไลน์
    function renderTimeline() {
      const selectedDate = document.getElementById('timelineDateInput').value;
      const dObj = new Date(selectedDate);
      document.getElementById('timelineSelectedDateText').innerText = `วัน${getDayName(dObj.getDay())}ที่ ${dObj.getDate()} ${thaiMonths[dObj.getMonth()]} ${dObj.getFullYear() + 543}`;

      renderDayPills(dObj);

      const dayEvents = getFilteredEvents().filter(e => e.dateKey === selectedDate);
      const rowsContainer = document.getElementById('timelineRows');
      rowsContainer.innerHTML = '';

      const startBaseHour = 7;  // 07:00
      const totalHours = 11;    // ถึง 18:00

      roomsList.forEach(roomName => {
        const eventsInRoom = dayEvents.filter(e => e.room === roomName);
        
        let blockHtml = eventsInRoom.map(ev => {
          const sHour = Math.max(startBaseHour, Math.min(18, ev.startHour));
          const eHour = Math.max(startBaseHour, Math.min(18, ev.endHour));

          const leftPercent = ((sHour - startBaseHour) / totalHours) * 100;
          const widthPercent = Math.max(1.5, ((eHour - sHour) / totalHours) * 100);

          return `
            <div class="absolute top-1.5 bottom-1.5 bg-[#00a8e8] text-white rounded-md px-2.5 text-xs flex items-center shadow border border-sky-600 truncate transition hover:brightness-105"
                 style="left: ${leftPercent}%; width: ${widthPercent}%; z-index: 10;"
                 title="${ev.startTime} - ${ev.endTime} : ${ev.title}">
              <span class="truncate font-semibold drop-shadow-sm tracking-wide text-[12px]">${ev.title}</span>
            </div>`;
        }).join('');

        rowsContainer.innerHTML += `
          <div class="flex items-center text-xs min-h-[52px] hover:bg-slate-50 transition">
            <div class="w-36 pl-3 font-bold text-slate-800 flex-shrink-0">${roomName}</div>
            <div class="flex-1 relative h-10 grid grid-cols-11 divide-x divide-slate-200 border-l border-slate-200">
              <div class="h-full"></div><div class="h-full"></div><div class="h-full"></div>
              <div class="h-full"></div><div class="h-full"></div><div class="h-full"></div>
              <div class="h-full"></div><div class="h-full"></div><div class="h-full"></div>
              <div class="h-full"></div><div class="h-full"></div>
              ${blockHtml}
            </div>
          </div>`;
      });
    }

    function renderDayPills(baseDate) {
      const container = document.getElementById('timelineDayPills');
      container.innerHTML = '';
      const dayLetters = ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'];

      for (let offset = -3; offset <= 3; offset++) {
        let temp = new Date(baseDate);
        temp.setDate(temp.getDate() + offset);
        const tempKey = formatDateKey(temp);
        const isSelected = tempKey === formatDateKey(baseDate);
        const count = rawBookings.filter(b => b.dateKey === tempKey).length;

        container.innerHTML += `
          <button onclick="selectTimelineDate('${tempKey}')" 
            class="flex-shrink-0 flex flex-col items-center justify-center w-12 py-1.5 rounded-lg border text-xs ${isSelected ? 'bg-sky-600 text-white border-sky-600 shadow-md font-semibold' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-50'}">
            <span>${dayLetters[temp.getDay()]}</span>
            <span class="font-bold text-sm my-0.5">${temp.getDate()}</span>
            <span class="text-[10px] opacity-75">${count}</span>
          </button>`;
      }
    }

    function selectTimelineDate(dateKey) {
      document.getElementById('timelineDateInput').value = dateKey;
      renderTimeline();
    }

    function buildDeptFilter() {
      const depts = [...new Set(rawBookings.map(b => b.creator))].filter(Boolean);
      const select = document.getElementById('filterDept');
      select.innerHTML = '<option value="">ทุกหน่วยงาน/ผู้จอง</option>';
      depts.forEach(d => {
        select.innerHTML += `<option value="${d}">${d}</option>`;
      });
    }

    function formatDateKey(d) {
      return `${d.getFullYear()}-${(d.getMonth() + 1).toString().padStart(2, '0')}-${d.getDate().toString().padStart(2, '0')}`;
    }

    function getDayName(idx) {
      return ['อาทิตย์', 'จันทร์', 'อังคาร', 'พุธ', 'พฤหัสบดี', 'ศุกร์', 'เสาร์'][idx];
    }
  </script>
</body>
</html>
